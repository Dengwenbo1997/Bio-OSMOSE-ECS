save_plot <- function(plot, filename, width_mm = 190, height_mm = 155, dpi = 600) {
w <- width_mm / 25.4
h <- height_mm / 25.4
grDevices::cairo_pdf(paste0(filename, ".pdf"), width = w, height = h, family = "Helvetica")
print(plot)
dev.off()
ragg::agg_png(paste0(filename, ".png"), width = w, height = h, units = "in", res = dpi)
print(plot)
dev.off()
ragg::agg_tiff(
paste0(filename, ".tiff"),
width = w, height = h, units = "in", res = dpi,
compression = "lzw"
)
print(plot)
dev.off()
}
save_plot(
figure_main,
file.path(output_dir, "Figure_individual_reproductive_allocation_index"),
width_mm = 190,
height_mm = 170
)
save_plot(
p_phase,
file.path(output_dir, "Figure_individual_reproductive_allocation_index_A_phase_space"),
width_mm = 190,
height_mm = 98
)
save_plot(
p_spectrum,
file.path(output_dir, "Figure_individual_reproductive_allocation_index_B_allocation_shift_spectrum"),
width_mm = 112,
height_mm = 122
)
save_plot(
p_transition,
file.path(output_dir, "Figure_individual_reproductive_allocation_index_C_strategy_transition"),
width_mm = 112,
height_mm = 92
)
message("Saved reproductive allocation analysis to: ", output_dir)
