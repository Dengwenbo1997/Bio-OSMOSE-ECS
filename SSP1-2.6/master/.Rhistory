)
flow_base_to_ssp126 <- strategy_transition_states |>
count(ssp126_strategy, name = "n_species") |>
transmute(
x = 1.08, xend = 1.92,
from_strategy = "Baseline allocation",
to_strategy = ssp126_strategy,
y = unname(strategy_y[from_strategy]),
yend = unname(strategy_y[to_strategy]),
n_species = n_species
)
flow_ssp126_to_ssp585 <- strategy_transition_states |>
count(ssp126_strategy, ssp585_strategy, name = "n_species") |>
transmute(
x = 2.08, xend = 2.92,
from_strategy = ssp126_strategy,
to_strategy = ssp585_strategy,
y = unname(strategy_y[from_strategy]),
yend = unname(strategy_y[to_strategy]),
n_species = n_species
)
flow_data <- bind_rows(flow_base_to_ssp126, flow_ssp126_to_ssp585) |>
mutate(to_strategy = factor(to_strategy, levels = strategy_levels))
node_data <- bind_rows(
tibble(
stage = "Base",
x = 1,
strategy = "Baseline allocation",
y = unname(strategy_y["Baseline allocation"]),
n_species = n_distinct(strategy_transition_states$species)
),
strategy_transition_states |>
count(strategy = ssp126_strategy, name = "n_species") |>
mutate(stage = "SSP1-2.6", x = 2, y = unname(strategy_y[strategy])),
strategy_transition_states |>
count(strategy = ssp585_strategy, name = "n_species") |>
mutate(stage = "SSP5-8.5", x = 3, y = unname(strategy_y[strategy]))
) |>
mutate(
strategy = as.character(strategy),
label = paste0(unname(strategy_label[strategy]), "\nn=", n_species)
)
p_transition <- ggplot() +
geom_curve(
data = flow_data,
aes(
x = x, xend = xend, y = y, yend = yend,
linewidth = n_species, color = to_strategy
),
curvature = 0.18, alpha = 0.36, lineend = "round"
) +
geom_label(
data = node_data,
aes(x = x, y = y, label = label, fill = strategy),
color = "black", fontface = "bold", size = 2.0, lineheight = 0.86,
label.size = 0.26, label.r = unit(1.2, "mm"),
label.padding = unit(1.5, "mm")
) +
annotate("text", x = c(1, 2, 3), y = 1.02, label = c("Base", "SSP1-2.6", "SSP5-8.5"), fontface = "bold", size = 2.45) +
scale_color_manual(values = strategy_colors, guide = "none", drop = FALSE) +
scale_fill_manual(values = c(strategy_colors, "Baseline allocation" = "#EEF1F4"), guide = "none", drop = FALSE) +
scale_linewidth(range = c(0.75, 5.5), guide = "none") +
scale_x_continuous(limits = c(0.72, 3.46), expand = c(0, 0)) +
scale_y_continuous(limits = c(-0.14, 1.08), expand = c(0, 0)) +
labs(x = NULL, y = NULL) +
theme_void(base_family = "Helvetica") +
theme(
panel.border = element_rect(fill = NA, color = "black", linewidth = 0.42),
plot.margin = margin(4, 5, 4, 5)
)
p_transition
